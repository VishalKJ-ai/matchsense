# Copy to .env (never committed) or export in your shell. Everything is optional:
# without Foundry settings MatchSense narrates locally with deterministic rules and templates.

# auto (default): use Foundry when configured, else local. local: never call a model. foundry: warn if not configured.
MATCHSENSE_NARRATION=auto

# From `azd env get-values` after `azd provision`. Sign in with `az login`; there are no API keys.
FOUNDRY_PROJECT_ENDPOINT=https://aif-xxxxxxxx.services.ai.azure.com/api/projects/proj-matchsense
FOUNDRY_MODEL_DEPLOYMENT=gpt-6-astra

# 1 registers the crew roles as versioned Foundry prompt agents (preview) and calls them by reference.
FOUNDRY_USE_AGENTS=0
FOUNDRY_REASONING_EFFORT=low
FOUNDRY_TIMEOUT_S=8
NARRATION_CALLS_PER_MINUTE=40

# Optional tracing to Application Insights (keyless).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Folder of generated matches served by the web app.
MATCHSENSE_DATA=data/matches
